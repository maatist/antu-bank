# =============================================================================
# Variables del stack REDUCIDO "demo" (tarea 12a.2, Requisito 12, criterio 2).
# =============================================================================
# Copiar a infra/.env.demo y completar con credenciales reales. NUNCA versionar .env.demo
# (el .dockerignore/.gitignore ya excluyen los .env; este archivo .example SÍ se versiona como
# plantilla, sin secretos reales).
#
# Uso:
#   docker compose --env-file infra/.env.demo -f infra/docker-compose.demo.yml up -d --build

# --- PostgreSQL consolidado (una sola instancia + base, schema por servicio) ---
DEMO_DB_NAME=neobank
DEMO_DB_USER=neobank
# Definir una contraseña robusta. El compose falla si no está definida.
DEMO_DB_PASSWORD=cambia-esta-clave

# --- Keycloak (IdP) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambia-esta-clave
# URL pública del realm que verán los servicios/clientes para validar el JWT. En el PaaS es la URL
# HTTPS pública de Keycloak (p. ej. https://auth.tu-dominio.com/realms/antu-bank). En local por
# defecto se usa la red interna del compose (http://keycloak:8080/realms/antu-bank).
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/antu-bank

# --- Kafka GESTIONADO GRATUITO (Upstash o Redpanda Serverless) ---
# Broker(s) del proveedor. Ejemplos de formato (usar el que entregue el proveedor):
#   Upstash:  <tu-endpoint>.upstash.io:9092
#   Redpanda: <tu-cluster>.cloud.redpanda.com:9092
KAFKA_BOOTSTRAP_SERVERS=tu-broker-gestionado:9092
# Protocolo y mecanismo SASL del proveedor (Upstash/Redpanda usan SASL_SSL + SCRAM-SHA-256).
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# jaas config con las credenciales del proveedor (usuario/clave que entrega el panel). El valor va
# en una sola línea. NO subir credenciales reales a git.
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="TU_USUARIO" password="TU_CLAVE";
