# =====================================================================
# Antu Bank Frontend — variables de entorno (ejemplo)
# Copia este archivo a `.env.local` y ajusta los valores.
# =====================================================================

# --- Autenticación (Auth.js v5 / NextAuth) ---------------------------
# Secreto propio de Auth.js para firmar la cookie de sesión. Genera uno con:
#   npx auth secret     (o)     openssl rand -base64 33
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL base pública del frontend. En local: http://localhost:3000
AUTH_URL="http://localhost:3000"

# --- Keycloak (client público antu-bank-frontend, Auth Code + PKCE) --
# Issuer del realm. Debe coincidir con infra/keycloak (puerto 8081).
AUTH_KEYCLOAK_ISSUER="http://localhost:8081/realms/antu-bank"

# clientId del client PÚBLICO definido en infra/keycloak/realm-export.json.
AUTH_KEYCLOAK_ID="antu-bank-frontend"

# El client es PÚBLICO (sin secreto). Déjalo vacío: la seguridad la aporta PKCE.
AUTH_KEYCLOAK_SECRET=""

# ---------------------------------------------------------------------
# Nota sobre nombres: Auth.js v5 usa el prefijo AUTH_*. Estos son los
# equivalentes de los nombres "clásicos" que quizá conozcas:
#   AUTH_SECRET           == NEXTAUTH_SECRET
#   AUTH_URL              == NEXTAUTH_URL
#   AUTH_KEYCLOAK_ISSUER  == KEYCLOAK_ISSUER
#   AUTH_KEYCLOAK_ID      == KEYCLOAK_CLIENT_ID
# ---------------------------------------------------------------------

# --- Backend (BFF GraphQL, tarea 10.2) ------------------------------
# URL del API Gateway / BFF GraphQL.
NEXT_PUBLIC_GATEWAY_URL="http://localhost:8080"

# RUT del titular para la demo. Los tokens demo de Keycloak NO mapean el atributo `rut` como
# claim del JWT, así que el frontend necesita el RUT para consultar el BFF (`me(rut: "...")`).
# Orden de resolución: claim `rut` del token → mapa por usuario demo → esta variable.
# En la demo, cliente.demo = 12.345.678-5.
DEMO_RUT="12.345.678-5"

# --- Ingreso invitado / demo (tarea 10.4) ----------------------------
# Usuario y contraseña demo que se muestran en la portada y que pre-rellena el botón
# "Entrar como invitado". El client de Keycloak es PÚBLICO (Auth Code + PKCE) y no permite
# direct grants, así que el ingreso pasa por la pantalla de Keycloak: el botón solo pre-rellena
# el usuario (login_hint) y basta confirmar con la contraseña. Coinciden con realm-export.json.
DEMO_USERNAME="cliente.demo"
DEMO_PASSWORD="demo1234"
