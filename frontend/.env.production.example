# =====================================================================
# Antu Bank Frontend — variables de PRODUCCIÓN para Vercel (tarea 12a.3,
# Requisito 12, criterio 1). Plantilla: cargar estos valores como
# "Environment Variables" del proyecto en Vercel (entorno Production).
# NUNCA versionar el archivo real con secretos (solo esta plantilla .example).
# =====================================================================

# --- Autenticación (Auth.js v5 / NextAuth) ---------------------------
# Secreto propio de Auth.js. Generar uno con: npx auth secret
# Marcar como "Sensitive" / Secret en Vercel.
AUTH_SECRET="genera-un-secreto-largo-y-aleatorio"

# URL base PÚBLICA del frontend en Vercel (HTTPS). Ej. https://antu-bank.vercel.app
AUTH_URL="https://TU-APP.vercel.app"

# --- Keycloak (client público antu-bank-frontend, Auth Code + PKCE) --
# Issuer del realm en el Keycloak PÚBLICO del backend (HTTPS). Debe coincidir con
# KEYCLOAK_ISSUER_URI del backend. Ej. (Render): https://antu-bank-keycloak.onrender.com/realms/antu-bank
#                                     (Fly.io):  https://antu-bank-keycloak.fly.dev/realms/antu-bank
AUTH_KEYCLOAK_ISSUER="https://TU-KEYCLOAK-PUBLICO/realms/antu-bank"

# clientId del client PÚBLICO definido en infra/keycloak/realm-export.json.
AUTH_KEYCLOAK_ID="antu-bank-frontend"

# Client PÚBLICO (sin secreto): dejar vacío. La seguridad la aporta PKCE.
AUTH_KEYCLOAK_SECRET=""

# --- Backend (API Gateway / BFF GraphQL) -----------------------------
# URL PÚBLICA HTTPS del api-gateway. Ej. (Render): https://antu-bank-gateway.onrender.com
#                                         (Fly.io):  https://antu-bank-gateway.fly.dev
NEXT_PUBLIC_GATEWAY_URL="https://TU-GATEWAY-PUBLICO"

# RUT del titular demo (el token demo no mapea el claim `rut`). Ver .env.example.
DEMO_RUT="12.345.678-5"

# --- Ingreso invitado / demo (tarea 10.4) ----------------------------
DEMO_USERNAME="cliente.demo"
DEMO_PASSWORD="demo1234"
